#!/usr/bin/env bash
# Fetch a repository's dependencies from its lockfiles into the cache volumes,
# in the networked prep container, so the agent phase can run with no network.
# Never fails the attempt: a fetch that fails is printed and skipped, and the
# agent finds out when it builds.
set -uo pipefail
cd /work || exit 0
status=0
try() {
  local what=$1; shift
  echo "warm-deps: $what"
  if ! "$@"; then echo "warm-deps: $what failed (continuing)"; status=1; fi
}

# corepack keeps its package manager copies under COREPACK_HOME, which points
# at the /cache/npm volume so the agent phase can reach them with no network
# and no writable root filesystem. The image bakes the pinned pnpm into
# /opt/corepack instead; copy that in the first time this repository's volume
# is used, so a repository whose packageManager field names the baked version
# never needs the network for it at all.
seed_corepack() {
  local home=${COREPACK_HOME:-/cache/npm/corepack}
  [ -d /opt/corepack ] || return 0
  mkdir -p "$home" || return 0
  if [ -z "$(ls -A "$home" 2>/dev/null)" ]; then
    echo "warm-deps: seeding corepack from /opt/corepack"
    cp -a /opt/corepack/. "$home/" || echo "warm-deps: seed corepack failed (continuing)"
  fi
}
seed_corepack

[ -f go.mod ] && try "go mod download" go mod download all
[ -f package-lock.json ] && try "npm ci" npm ci --ignore-scripts --no-audit --no-fund
if [ -f pnpm-lock.yaml ]; then
  # No version argument: corepack activates whatever the repository's own
  # packageManager field pins, and this is the one phase with the network to
  # fetch it when that is not the version the image baked.
  try "corepack prepare" corepack prepare --activate
  try "pnpm install" pnpm install --frozen-lockfile --ignore-scripts
fi
[ -f uv.lock ] && try "uv sync" uv sync --frozen --no-install-project
if [ -f requirements.txt ] && [ ! -f uv.lock ]; then echo "warm-deps: requirements.txt without uv.lock; skipped"; fi
[ $status -eq 0 ] && echo "warm-deps: done" || echo "warm-deps: done with failures"
exit 0
